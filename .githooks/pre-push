#!/usr/bin/env bash
# Block pushes that:
#   1) contain secrets (infisical scan)
#   2) have author/committer != Mörgæsis <morgaesis+git@morgaes.is>
#   3) are not GPG-signed (locally verifiable signature)
#   4) leak forbidden tokens in commit metadata or diff
set -euo pipefail

EXPECTED_NAME="Mörgæsis"
EXPECTED_EMAIL="morgaesis+git@morgaes.is"
FORBIDDEN_TOKENS='(Paperclip|paperclip\.dev|/home/paperclip|@paperclip\.ing|Co-Authored-By: Paperclip|Paperclip-Id:|Morgan Chen|Alex Kim|Jordan Lee|Casey Park|Riley Patel|👑 Sovereign|POSA-[0-9]+|MOR-[0-9]+)'

zero=0000000000000000000000000000000000000000
any_fail=0

refs=$(cat)

while IFS= read -r line; do
  [ -z "$line" ] && continue
  # shellcheck disable=SC2086
  set -- $line
  local_ref="$1"; local_sha="$2"; remote_ref="$3"; remote_sha="$4"
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
    revlist=$(git rev-list "$local_sha" --not --remotes=origin 2>/dev/null || git rev-list "$local_sha")
  else
    range="${remote_sha}..${local_sha}"
    revlist=$(git rev-list "$range")
  fi

  if command -v infisical >/dev/null 2>&1; then
    if ! infisical scan --log-opts="$range" --redact --verbose --exit-code 2; then
      printf '\npre-push: secrets detected in range %s\n' "$range" >&2
      any_fail=1
    fi
  else
    printf 'pre-push: infisical CLI not installed; skipping secret scan.\n' >&2
  fi

  for sha in $revlist; do
    name=$(git log -1 --format='%an' "$sha")
    email=$(git log -1 --format='%ae' "$sha")
    cname=$(git log -1 --format='%cn' "$sha")
    cemail=$(git log -1 --format='%ce' "$sha")
    sig=$(git log -1 --format='%G?' "$sha")

    if [ "$name" != "$EXPECTED_NAME" ] || [ "$email" != "$EXPECTED_EMAIL" ]; then
      printf 'pre-push: %s author %s <%s> != %s <%s>\n' \
        "${sha:0:8}" "$name" "$email" "$EXPECTED_NAME" "$EXPECTED_EMAIL" >&2
      any_fail=1
    fi
    # Committer must be Mörgæsis, or GitHub for squash-merge commits pulled into a branch.
    if { [ "$cname" != "$EXPECTED_NAME" ] || [ "$cemail" != "$EXPECTED_EMAIL" ]; } \
       && ! { [ "$cname" = "GitHub" ] && [ "$cemail" = "noreply@github.com" ]; }; then
      printf 'pre-push: %s committer %s <%s> not allowed\n' "${sha:0:8}" "$cname" "$cemail" >&2
      any_fail=1
    fi
    # %G? values: G good, U good unknown validity, X expired sig, Y expired key, R revoked, E missing key (still signed), B bad, N no signature
    case "$sig" in
      G|U|E|X|Y) : ;;
      *)
        printf 'pre-push: %s is not GPG-signed (%%G? = %s)\n' "${sha:0:8}" "$sig" >&2
        any_fail=1
        ;;
    esac

    if git log -1 --format='%B' "$sha" | grep -Eq "$FORBIDDEN_TOKENS"; then
      printf 'pre-push: %s commit message contains forbidden tokens\n' "${sha:0:8}" >&2
      any_fail=1
    fi
    # Exclude the hook scripts themselves from the diff scan — they list these
    # tokens literally as the forbidden set.
    if git show --no-color --format= "$sha" -- ':(exclude).githooks/pre-push' ':(exclude).githooks/commit-msg' \
       | grep -Eq "$FORBIDDEN_TOKENS"; then
      printf 'pre-push: %s diff contains forbidden tokens (agent/paperclip refs)\n' "${sha:0:8}" >&2
      any_fail=1
    fi
  done
done <<< "$refs"

if [ "$any_fail" -ne 0 ]; then
  printf '\npre-push: blocked. Fix author/committer/signing/leakage issues, then retry.\n' >&2
  exit 1
fi
