#!/usr/bin/env bash
# Validate commit message follows Conventional Commits.
set -eo pipefail

msg_file="$1"
msg=$(head -n 1 "$msg_file")
cc_regex='^(feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert)(\(.+\))?: .+$'

if ! echo "$msg" | grep -qE "$cc_regex"; then
  printf 'commit-msg: title does not follow Conventional Commits.\n' >&2
  printf '            expected: <type>: <description>\n' >&2
  printf '            allowed types: feat, fix, perf, refactor, docs, test, build, ci, chore, style, revert\n' >&2
  exit 1
fi

if [ "${#msg}" -gt 72 ]; then
  printf 'commit-msg: subject line exceeds 72 characters (%d).\n' "${#msg}" >&2
  exit 1
fi

if echo "$msg" | grep -qE '\.$'; then
  printf 'commit-msg: subject line must not end with a period.\n' >&2
  exit 1
fi
