#!/usr/bin/env bash
# Block commits that stage secrets. Runs infisical scan against the staged diff.
set -euo pipefail

if ! command -v infisical >/dev/null 2>&1; then
  printf 'pre-commit: infisical CLI not installed; skipping secret scan.\n' >&2
  printf '            install: https://infisical.com/docs/cli/overview\n' >&2
  exit 0
fi

infisical scan git-changes --staged --redact --verbose --exit-code 2 || {
  rc=$?
  printf '\npre-commit: secret scan found potential leaks. Commit blocked.\n' >&2
  printf '           if this is a false positive, add the fingerprint to .infisical-scan.toml under [[rules]].\n' >&2
  exit "$rc"
}
