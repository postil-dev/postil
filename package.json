{
  "name": "postil",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI PR reviewer",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "bun scripts/install-hooks.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark:pr-review": "tsx scripts/run-pr-review-benchmark.ts",
    "postil": "POSTIL_CLI_GIT=https://github.com/postil-dev/postil-cli POSTIL_CLI_REV=f25e97bbe473d2df957453bf5439904839a2959c scripts/run-postil.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "trigger:dev": "trigger dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@polar-sh/better-auth": "^1.8.3",
    "@polar-sh/sdk": "^0.47.0",
    "@trigger.dev/sdk": "4.4.6",
    "better-auth": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.0",
    "lucide-react": "^1.8.0",
    "next": "15.5.15",
    "pg": "^8.20.0",
    "posthog-js": "^1.373.5",
    "posthog-node": "^5.29.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-grab": "^0.1.44",
    "shadcn": "^4.3.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "trigger.dev": "^4.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all"
  ]
}
