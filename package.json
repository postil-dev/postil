    "better-auth": "^1.6.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "15",
    "postcss": "^8.5.15",
    "postgres": "^3.4.9",
    "posthog-node": "^5.36.15",
    "react": "19",
    "react-dom": "19",
    "tailwindcss": "4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
