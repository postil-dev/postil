# Postil environment.
#
# Anything left blank in your real .env disables the corresponding subsystem.
# The CLI is the only thing that requires OPENROUTER_API_KEY; the backend is
# happy to run without it for local UI development.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://postil:postil@localhost:5432/postil

# --- GitHub App ---
# Create one at https://github.com/settings/apps/new.
# Permissions: Contents: Read, Pull requests: Read & write, Checks: Read & write.
# Subscribe to: pull_request, installation.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALL_URL=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Model provider (used by the CLI subprocess) ---
OPENROUTER_API_KEY=
REVIEW_MODEL=deepseek/deepseek-v4-pro
REVIEW_MODEL_CASCADE=

# --- Worker ---
POSTIL_CLI_PATH=postil
# 32+ bytes random. Encrypts the short-lived installation token before handing
# it to the worker over the job queue.
REVIEW_TOKEN_SECRET=

# --- Operator endpoints ---
METRICS_API_KEY=

# --- Polar (billing) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# --- Analytics ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
