# Postil environment variables
# Copy to .env.local for local dev and fill in.
# Variable names align with the registered services (Neon, Fly, PostHog,
# Polar, OpenRouter), so you can often just copy-paste across machines.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Database (Neon / Postgres) ---
# Pooled URL, Neon calls it "connection string"
NEON_CONNECTION_STRING=
# Direct (unpooled) for migrations; optional but recommended
DATABASE_URL_UNPOOLED=
# Neon control-plane key, used to create branches programmatically
NEON_PERSONAL_API_KEY=
# Self-host fallback (Neon users can ignore)
DATABASE_URL=

# --- GitHub App (runtime webhook + installation tokens) ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encoded PEM (recommended): `base64 -w0 app.private-key.pem`
GITHUB_APP_PRIVATE_KEY_B64=
# Or raw PEM (with literal \n line breaks) as a fallback
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# App slug for the GitHub App install URL, e.g. "postil"
GITHUB_APP_SLUG=
# Personal access token — bootstrap and CI only, not for request auth
GITHUB_PAT=

# --- Polar (billing) ---
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_ORG_ID=
POLAR_ORG_SLUG=
POLAR_ENVIRONMENT=sandbox

# --- Trigger.dev ---
TRIGGER_API_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_API_URL=https://api.trigger.dev

# --- Fly.io ---
FLY_ORG_TOKEN=
FLY_ORG_SLUG=personal
FLY_SANDBOX_APP=

# --- PostHog (EU) ---
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_REGION=eu
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Client-side PostHog analytics (optional; required for marketing site events)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- OpenRouter (review bot via opencode CLI) ---
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
REVIEW_MODEL=moonshotai/kimi-k2.6

# --- Cloudflare (DNS ops) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Sandbox driver (fly | e2b | docker) ---
SANDBOX_DRIVER=fly
