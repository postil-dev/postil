# Postil control plane configuration.
# Copy to .env and fill in. Web and worker validate required values at boot
# and exit with the missing variable, its purpose, and an example.

# --- Database (required: web + worker) -------------------------------------
# Postgres connection string. The bundled docker-compose provides this host.
DATABASE_URL=postgres://postil:postil@db:5432/postil

# --- Web sessions and webhooks (required: web) ------------------------------
# HMAC key for signing session cookies. Generate: openssl rand -hex 32
POSTIL_SESSION_SECRET=

# Shared secret for GitHub webhook signature verification
# (X-Hub-Signature-256). Must match the secret on the GitHub App's webhook
# settings page. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth app (dashboard sign-in; separate from the GitHub App).
# Callback URL must be: https://<your-host>/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (required: worker) ------------------------------------------
# Numeric App id from the GitHub App settings page.
GITHUB_APP_ID=

# The App's private key. Raw PEM (multiline or \n-escaped) or base64-encoded
# PEM both work. Never logged, never stored in the database.
GITHUB_APP_PRIVATE_KEY=

# --- Secret sealing (required: web + worker) --------------------------------
# AES-256-GCM key sealing org BYO API keys at rest. 32 bytes as 64 hex chars
# or base64. Generate: openssl rand -hex 32
POSTIL_SEALING_KEY=

# --- LLM defaults (optional: worker) ----------------------------------------
# Used when an organization has not configured its own BYO key/settings.
# POSTIL_API_KEY falls back to OPENROUTER_API_KEY if unset.
POSTIL_API_KEY=
#OPENROUTER_API_KEY=
# OpenAI-compatible base URL. Examples:
#   OpenRouter:    https://openrouter.ai/api/v1   (default)
#   Azure OpenAI:  https://<resource>.openai.azure.com/openai/v1
#   Ollama:        http://ollama:11434/v1
POSTIL_API_BASE=https://openrouter.ai/api/v1
REVIEW_MODEL=deepseek/deepseek-v4-pro
# Comma-separated fallbacks tried in order on provider errors.
REVIEW_MODEL_CASCADE=

# GitHub Enterprise Server: point both the worker and the spawned CLI at your
# instance's API (one variable covers both). Leave unset for github.com.
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Worker (optional) -------------------------------------------------------
# Path to the postil CLI binary. The Docker image bakes it at
# /usr/local/bin/postil; for bare-metal dev it defaults to `postil` on PATH.
POSTIL_BIN=/usr/local/bin/postil
# Concurrent review slots (default 4).
WORKER_CONCURRENCY=4
# Directory for transient baseline files (default .cache).
POSTIL_CACHE_DIR=.cache

# --- Observability (optional: web) ------------------------------------------
# Bearer token protecting GET /api/metrics (Prometheus text format).
# Metrics are disabled when unset. Generate: openssl rand -hex 24
METRICS_TOKEN=
