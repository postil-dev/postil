# Postil environment variables
# Copy to .env.local for local dev and fill in.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Used by Better Auth. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Database (Neon / Postgres) ---
# Pooled connection for runtime
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postil
# Direct (unpooled) for migrations
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/postil

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM, with literal \n line breaks or wrap in quotes
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Polar (billing) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_ENVIRONMENT=sandbox

# --- Trigger.dev ---
TRIGGER_API_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_API_URL=https://api.trigger.dev

# --- Fly.io (sandbox driver) ---
FLY_API_TOKEN=
FLY_ORG_SLUG=personal
FLY_SANDBOX_APP=postil-sandbox

# --- PostHog (EU) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Cloudflare (DNS ops) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Sandbox driver selection ---
# fly | e2b | docker
SANDBOX_DRIVER=fly
